          <hashTree />
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Assign CSV fixture and iteration" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (!vars.get('slot')) {
    def lines = new File(props.getProperty('fixture', '../data/admin-fixtures.csv')).readLines('UTF-8')
    def keys = lines[0].split(',', -1)
    def row = lines[ctx.threadNum + 0 + 1].split(',', -1)
    assert row.size() == keys.size()
    keys.eachWithIndex { key, i -&gt; vars.put(key, row[i]) }
}
def n = vars.getIteration()
vars.put('price', vars.get(n % 2 == 1 ? 'high' : 'low'))
vars.put('code', 'G4-' + props.getProperty('runId', 'local') + '-' + vars.get('slot') + '-' + n)</stringProp>
          </JSR223PreProcessor>
          <hashTree />
        </hashTree>
